# vim: set ft=bash
#
# Sole purpose of /sailhome/ranjanr: move an interactive login onto node-local
# storage and hand over to fish. Nothing of value is kept there. The node-local
# home is a dotfiles checkout with its own pixi install; setup-node.sh creates
# both, so the first login to a node sets the node up.

LFS_HOME="/lfs/local/0/ranjanr"
if [[ ! -d $LFS_HOME/.git ]]
then
	echo "setting up $LFS_HOME"
	curl -fsSL https://raw.githubusercontent.com/rishabh-ranjan/dotfiles/main/setup-node.sh | bash
fi
if [[ -d $LFS_HOME ]]
then
	export HOME="$LFS_HOME"
fi
echo HOME="$HOME"
cd

# if not interactive, exit
[[ $- != *i* ]] && return

export PIXI_HOME="$HOME/.pixi"
FISH_SHELL="$PIXI_HOME/bin/fish"
if [[ -x $FISH_SHELL ]]
then
	export SHELL="$FISH_SHELL"
fi
echo SHELL="$SHELL"
exec $SHELL
