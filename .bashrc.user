# Kerberos: stanford.edu realm (FarmShare) — system krb5.conf has stale KDCs
export KRB5_CONFIG=/afs/cs.stanford.edu/u/ranjanr/.krb5.conf

# vim: set ft=bash
#
# Sole purpose of /sailhome/ranjanr: move an interactive login onto node-local
# storage and hand over to fish. Nothing of value is kept there. The node-local
# home is a dotfiles checkout with its own pixi install; setup-node.sh creates
# both, so the first login to a node sets the node up.

# This is the one path that brings a node up to spec, for interactive logins
# and for batch jobs alike (a slurm script with `#!/bin/bash -l` is a login
# shell, so it lands here too). setup-node.sh is a few stat calls and no
# network once the node is set up, so running it every time is free.
if [[ -d /lfs ]]
then
	LFS_HOME="/lfs/local/0/ranjanr"
	if [[ -f $LFS_HOME/setup-node.sh ]]
	then
		bash "$LFS_HOME/setup-node.sh" || echo "WARNING: setup-node.sh failed" >&2
	else
		echo "setting up $LFS_HOME"
		curl -fsSL https://raw.githubusercontent.com/rishabh-ranjan/dotfiles/main/setup-node.sh | bash
	fi
	if [[ -d $LFS_HOME ]]
	then
		export HOME="$LFS_HOME"
	fi
	echo HOME="$HOME"
	cd
elif [[ -d /marlowe ]]
then
	# Marlowe: the home is already this checkout; setup-node.sh only keeps
	# it to spec (pixi version, the symlinks into scratch).
	bash "$HOME/setup-node.sh" || echo "WARNING: setup-node.sh failed" >&2
fi

# if not interactive, exit
[[ $- != *i* ]] && return

export PIXI_HOME="$HOME/.pixi"
FISH_SHELL="$PIXI_HOME/bin/fish"
if [[ -x $FISH_SHELL ]]
then
	export SHELL="$FISH_SHELL"
fi
echo SHELL="$SHELL"
exec $SHELL
