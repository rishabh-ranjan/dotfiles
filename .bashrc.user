# vim: set ft=bash
#
# Sole purpose of /sailhome/ranjanr: move an interactive login onto node-local
# storage and hand over to fish. Nothing of value is kept here -- secrets and
# the pixi install live on /dfs/user/ranjanr, node-local dirs are created on
# demand, so no node needs to be set up in advance.

DFS_HOME="/dfs/user/ranjanr"
export PIXI_HOME="$DFS_HOME/.pixi"
PATH="$PIXI_HOME/bin:$PATH"

# The node-local home is a checkout of the dotfiles repo. Clone it if this node
# has never been used before, so no node needs to be prepared by hand.
LFS_HOME="/lfs/local/0/ranjanr"
if [[ ! -d $LFS_HOME/.git ]] && command -v git >/dev/null
then
	echo "bootstrapping $LFS_HOME from dotfiles"
	mkdir -p "$LFS_HOME"
	git clone --quiet https://github.com/rishabh-ranjan/dotfiles "$LFS_HOME.dotfiles" &&
		mv "$LFS_HOME.dotfiles"/.git "$LFS_HOME/" &&
		git -C "$LFS_HOME" checkout --quiet -- . &&
		rm -rf "$LFS_HOME.dotfiles"
fi
if [[ -d $LFS_HOME ]]
then
	export HOME="$LFS_HOME"
fi
echo HOME="$HOME"
cd

# if not interactive, exit
[[ $- != *i* ]] && return

FISH_SHELL="$PIXI_HOME/bin/fish"
if [[ -x $FISH_SHELL ]]
then
	export SHELL="$FISH_SHELL"
fi
echo SHELL="$SHELL"
exec $SHELL
